# AI Provider
AI_PROVIDER=deepseek
AI_PROVIDER_FALLBACKS=false
AI_PROVIDER_TIMEOUT_MS=12000
AI_MAX_INPUT_CHARS=3500
AI_MAX_OUTPUT_TOKENS=400
OPTIONAL_ANALYSIS_BUDGET_MS=32000

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SITE_URL=https://www.aeocheck.co/
OPENROUTER_APP_NAME=AEOCheck

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google PageSpeed
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=28000

# Jina
JINA_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_ENABLE_AI_REPORT=true
NEXT_PUBLIC_APP_URL=https://aeocheck.co/
MASTER_ADMIN_EMAILS=

# Usage Limits
GUEST_DAILY_SCAN_LIMIT=5
FREE_DAILY_SCAN_LIMIT=10
PRO_DAILY_SCAN_LIMIT=1000000

# Resend (email)
RESEND_API_KEY=
CONTACT_EMAIL=

# Polar (payments)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=
POLAR_FULL_REPORT_PRODUCT_ID=
POLAR_PRO_MONTHLY_PRODUCT_ID=
NEXT_PUBLIC_POLAR_FULL_REPORT_PRODUCT_ID=
NEXT_PUBLIC_POLAR_PRO_MONTHLY_PRODUCT_ID=

# Dev only - never enable in production
# AEO_DEV_BYPASS_SCAN_LIMIT=true