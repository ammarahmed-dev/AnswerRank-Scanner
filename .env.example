# Optional: enables AI-powered recommendations. Without it, the app uses deterministic fallback analysis.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for structured report analysis.
OPENAI_MODEL=gpt-4o-mini

# Optional fallback AI provider. OpenAI is used first when both keys are set.
GEMINI_API_KEY=

# Optional: enables real Google PageSpeed performance scoring. Without it, performance uses fallback heuristics.
GOOGLE_PAGESPEED_API_KEY=
